# Copy to .env (chmod 600). Never commit .env. Defaults live in src/mikiwame/config.py.
TELEGRAM_BOT_TOKEN=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# 64 hex chars. Losing or rotating it breaks indicator matching (recidivism).
MIKIWAME_HMAC_KEY=
# Telegram chat that receives admin alerts.
MIKIWAME_ADMIN_CHAT_ID=
# Optional: a command that receives the alert text on stdin (empty or "off": none).
# MIKIWAME_NOTIFY_GATE=
# Comma-separated Telegram user ids allowed while the bot is closed.
MIKIWAME_ALLOWED_USERS=

# MIKIWAME_INSTANCE=estimo
# MIKIWAME_DATABASE_URL=sqlite:///var/estimo.db
# Optional local mirror of rental listings (SQLite; no sync client ships here):
# MIKIWAME_MARKET_DATABASE_URL=sqlite:///var/market.db

# Optional overrides. Models are "provider:model" and must pass the model policy (registry.py).
# MIKIWAME_MODEL_VISION=opencode-go:gpt-6-luna
# MIKIWAME_MODEL_TEXT=opencode-go:gpt-6-luna
# MIKIWAME_MODEL_ADVERSARIAL=opencode-go:gpt-6-luna
# MIKIWAME_EFFORT_ADVERSARIAL=low
# MIKIWAME_BUDGET_DAILY_USD_TOTAL=0.50
# MIKIWAME_BUDGET_MONTHLY_USD_PER_MODEL=3.00
# MIKIWAME_LIMIT_USER_DAILY=5
# MIKIWAME_MAX_IMAGES=8
# MIKIWAME_LIMIT_GLOBAL_DAILY=40
# MIKIWAME_RETENTION_DAYS=30
# Street check against OpenStreetMap's Nominatim (1 request/s). false turns it off.
# MIKIWAME_ADDRESS_CHECK=true
# MIKIWAME_OPEN_ACCESS=
# MIKIWAME_WEB_PORT=8770
# MIKIWAME_WEB_TRUSTED_PROXIES=
